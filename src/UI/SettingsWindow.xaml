<Window x:Class="MsgImageExtractor.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MSG Image Extractor — Settings"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,4,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Watched folder label -->
            <RowDefinition Height="Auto"/>  <!-- Watched folder row -->
            <RowDefinition Height="Auto"/>  <!-- Output strategy label -->
            <RowDefinition Height="Auto"/>  <!-- Output strategy dropdown -->
            <RowDefinition Height="Auto"/>  <!-- Output folder row (conditional) -->
            <RowDefinition Height="Auto"/>  <!-- Max concurrent label -->
            <RowDefinition Height="Auto"/>  <!-- Max concurrent slider -->
            <RowDefinition Height="Auto"/>  <!-- Min size label -->
            <RowDefinition Height="Auto"/>  <!-- Min size input -->
            <RowDefinition Height="Auto"/>  <!-- Deduplicate checkbox -->
            <RowDefinition Height="Auto"/>  <!-- Extract inline checkbox -->
            <RowDefinition Height="Auto"/>  <!-- Recurse embedded checkbox -->
            <RowDefinition Height="16"/>    <!-- Spacer -->
            <RowDefinition Height="Auto"/>  <!-- Buttons row -->
        </Grid.RowDefinitions>

        <!-- ── Watched folder ───────────────────────────────────────────── -->
        <Label Grid.Row="0" Content="Watched folder"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="WatchedFolderBox" Grid.Column="0"
                     IsReadOnly="True" Margin="0,0,4,0"
                     Text="{Binding WatchedFolder, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="1" Content="Browse…" Click="BrowseWatchedFolder_Click"/>
        </Grid>

        <!-- ── Output strategy ──────────────────────────────────────────── -->
        <Label Grid.Row="2" Content="Output strategy" Margin="0,8,0,0"/>
        <ComboBox x:Name="OutputStrategyCombo" Grid.Row="3"
                  SelectionChanged="OutputStrategy_SelectionChanged">
            <ComboBoxItem Content="Same Folder" Tag="SameFolder"/>
            <ComboBoxItem Content="Custom Folder" Tag="CustomFolder"/>
        </ComboBox>

        <!-- ── Output folder (visible only when CustomFolder selected) ──── -->
        <Grid Grid.Row="4" x:Name="OutputFolderRow" Visibility="Collapsed" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="OutputFolderBox" Grid.Column="0"
                     IsReadOnly="True" Margin="0,0,4,0"
                     Text="{Binding CustomFolder, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="1" Content="Browse…" Click="BrowseOutputFolder_Click"/>
        </Grid>

        <!-- ── Max concurrent extractions ──────────────────────────────── -->
        <Label Grid.Row="5" Content="Max concurrent extractions" Margin="0,8,0,0"/>
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="MaxConcurrentSlider" Grid.Column="0"
                    Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="MaxConcurrent_ValueChanged"/>
            <TextBlock x:Name="MaxConcurrentLabel" Grid.Column="1"
                       VerticalAlignment="Center" TextAlignment="Center"/>
        </Grid>

        <!-- ── Minimum attachment size ──────────────────────────────────── -->
        <Label Grid.Row="7" Content="Minimum attachment size (KB)" Margin="0,8,0,0"/>
        <TextBox x:Name="MinSizeBox" Grid.Row="8"
                 TextChanged="MinSize_TextChanged" MaxLength="6"/>

        <!-- ── Checkboxes ────────────────────────────────────────────────  -->
        <CheckBox x:Name="DeduplicateCheck" Grid.Row="9"
                  Content="Deduplicate identical images (SHA-256)"
                  Checked="Deduplicate_Changed" Unchecked="Deduplicate_Changed"
                  Margin="0,12,0,0"/>

        <CheckBox x:Name="InlineImagesCheck" Grid.Row="10"
                  Content="Extract inline images (CID references from HTML body)"
                  Checked="InlineImages_Changed" Unchecked="InlineImages_Changed"/>

        <CheckBox x:Name="RecurseEmbeddedCheck" Grid.Row="11"
                  Content="Recurse into embedded messages"
                  Checked="RecurseEmbedded_Changed" Unchecked="RecurseEmbedded_Changed"/>

        <!-- ── Action buttons ────────────────────────────────────────────  -->
        <StackPanel Grid.Row="13" Orientation="Vertical">
            <Separator Margin="0,0,0,8"/>
            <Button Content="Reset processed file history"
                    Click="ResetHistory_Click"
                    ToolTip="Deletes all sentinel files. All .msg files will be re-extracted on next run."/>
            <Button Content="Clear image dedup cache"
                    Click="ClearDedupCache_Click"
                    ToolTip="Clears the in-memory hash set for this session."/>
        </StackPanel>
    </Grid>
</Window>
